  "cards": [
    {
      "dot": "slate",
      "title": "Where this trace starts",
      "items": [
        "The browser already has a server-priced quote from POST /api/quotes and the customer has accepted it.",
        "This sequence starts when React submits that quote to POST /api/orders."
      ]
    },
    {
      "dot": "emerald",
      "title": "Why retries are safe",
      "items": [
        "Before POST /api/orders, React saves the same idempotency key in sessionStorage.",
        "The order key and request hash make a repeated request resolve to its existing order and attempt.",
        "A missing status result is not treated as a decline; the client keeps checking the same key."
      ]
    },
    {
      "dot": "orange",
      "title": "Demo payment boundary",
      "items": [
        "Outcomes are simulated and persisted locally. The project does not collect card data or call a payment provider.",
        "Approval assigns a pickup number; decline releases stock. StillUnknown writes no ledger row and stays pending."
      ]
    }
  ]
