{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"node scripts/run-api.mjs\" \"vite\"",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:types": "node ../scripts/generate-api-types.mjs",
    "api:update": "node ../scripts/update-openapi-snapshot.mjs",
    "e2e": "npm run build && playwright test",
    "e2e:only": "playwright test",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
